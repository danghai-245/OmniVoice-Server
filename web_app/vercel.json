{
  "version": 2,
  "name": "hth-voicevip",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "Voice.json,capcut_tts_api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/capcut/:path*",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
